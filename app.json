{
  "expo": {
    "name": "도로시",
    "slug": "dorothy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dorothybrew.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dorothybrew.app",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#6C5CE7"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "도로시에게 음성으로 말하려면 마이크가 필요해요.",
          "speechRecognitionPermission": "말씀하신 내용을 글자로 바꾸려면 음성 인식이 필요해요.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withAssistIntent",
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": true
        }
      ],
      "expo-background-task",
      [
        "expo-contacts",
        {
          "contactsPermission": "전화·문자 온 번호를 이름으로 알려드리려면 연락처가 필요해요. 연락처는 휴대폰 밖으로 저장되지 않아요."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지금 계신 곳 기준으로 날씨와 이동을 챙겨드리려면 위치가 필요해요. 위치는 휴대폰 밖으로 저장되지 않아요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "영수증·입고표·화면 캡처 같은 사진을 도로시에게 보여주려면 사진 접근이 필요해요.",
          "cameraPermission": "서류나 화물을 바로 찍어 도로시에게 보여주려면 카메라가 필요해요."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "카메라로 보여주며 도로시와 대화하려면 카메라가 필요해요.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}