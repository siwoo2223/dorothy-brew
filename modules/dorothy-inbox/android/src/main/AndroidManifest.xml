<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <uses-permission android:name="android.permission.READ_SMS" />

  <application>
    <!-- Saves incoming messenger notifications so Dorothy can sum up what needs doing. Off until the user grants notification access. -->
    <service
      android:name="expo.modules.dorothyinbox.DorothyNotificationListener"
      android:exported="true"
      android:label="도로시 메시지 정리"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Notices when the owner sends a KakaoTalk/messenger reply, so Dorothy can auto-clear a 회신 대기. Off until the user grants accessibility access. Stores no message text. -->
    <service
      android:name="expo.modules.dorothyinbox.DorothyReplyListener"
      android:exported="true"
      android:label="도로시 답장 자동 감지"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/dorothy_reply_config" />
    </service>
  </application>
</manifest>
