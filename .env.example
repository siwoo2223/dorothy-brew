# 복사해서 쓰세요:  cp .env.example .env
# .env는 .gitignore에 있습니다. 절대 커밋하지 마세요.

# --- Bitget API (live 모드에서만 필요) ---
# 발급: Bitget → API 관리 → 새 API 생성
# ⚠ 권한 설정에서 "출금(Withdraw)"은 반드시 끄세요. 거래 권한만 켭니다.
# ⚠ 가능하면 IP 화이트리스트를 걸어두세요. 키가 유출돼도 다른 곳에서는 못 씁니다.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSWORD=

# --- 텔레그램 알림 (선택) ---
# @BotFather 에서 봇 생성 후 토큰 발급, @userinfobot 으로 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
